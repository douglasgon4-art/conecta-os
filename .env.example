# Conexión de la aplicación (rol SIN BYPASSRLS; las políticas RLS se aplican)
DATABASE_URL=postgres://conecta_app:conecta_app@localhost:5432/conecta
# Conexión del propietario del esquema (solo migraciones y seed)
DATABASE_OWNER_URL=postgres://conecta_owner:conecta_owner@localhost:5432/conecta
# Secreto para el endpoint de automatizaciones (/api/cron)
CRON_SECRET=cambia-esto
# Zona horaria operativa
APP_TIMEZONE=America/Managua
# Directorio privado de archivos subidos
FILE_STORAGE_DIR=./storage
# Agente de IA (opcional; sin clave el asistente indica que está pendiente de configuración)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
